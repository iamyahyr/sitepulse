# Configuration for docker-compose.yml. Copy to .env and fill in the blanks.
# Generate each secret with:  openssl rand -hex 32
# (hex, not base64: the password goes inside a postgres:// URL, where "/" or "+" would break it)

# Public URL where you will open SitePulse (used for login cookies and links in alerts)
APP_URL=http://localhost:3000
# Host port for the web app
PORT=3000

POSTGRES_PASSWORD=
# Signs login sessions
BETTER_AUTH_SECRET=
# Encrypts alert channel settings. Changing it later makes existing channels unreadable.
SITEPULSE_SECRET_KEY=

# ── Optional ────────────────────────────────────────────────────────────
# Dead-man's switch pinged every minute while the worker is healthy (e.g. healthchecks.io)
# HEARTBEAT_URL=
# Private networks SitePulse may monitor and send webhooks to (homelab, internal n8n…)
# ALLOW_PRIVATE_CIDRS=192.168.1.0/24
# WORKER_CONCURRENCY=10
# Raw checks are kept this long; hourly aggregates (charts, baselines) much longer
# CHECK_RETENTION_DAYS=30
# ROLLUP_RETENTION_DAYS=400
# MAX_SITES_PER_USER=50
# MIN_INTERVAL_SEC=60
# Pin a release instead of latest
# SITEPULSE_VERSION=latest
