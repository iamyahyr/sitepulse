DATABASE_URL=postgres://sitepulse:sitepulse@localhost:5442/sitepulse
# Same value as the web app's SITEPULSE_SECRET_KEY
SITEPULSE_SECRET_KEY=
# Public URL of the web app, for links in alerts
APP_URL=http://localhost:3000

# Optional
# WORKER_CONCURRENCY=10
# WORKER_POLL_MS=2000
# HEARTBEAT_URL=https://hc-ping.com/<uuid>
# ALLOW_PRIVATE_CIDRS=192.168.1.0/24
# RUN_MIGRATIONS=true
# CHECK_RETENTION_DAYS=30
# ROLLUP_RETENTION_DAYS=400
# MAINTENANCE_INTERVAL_MS=300000
# Self-connectivity guard: if none of these answer, the worker assumes *it* is
# offline and does not hold network failures against your sites.
# Empty value disables that kind of canary.
# CONNECTIVITY_TCP_TARGETS=1.1.1.1:443,8.8.8.8:443,9.9.9.9:443
# CONNECTIVITY_DNS_NAMES=cloudflare.com,google.com,quad9.net
